# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# Environment: development | test | production
NODE_ENV=development

# Public base URL of the app (used for CORS + absolute links)
APP_URL=http://localhost:3000

# PostgreSQL connection string used for RUNTIME QUERIES.
# In production this should be Neon's POOLED endpoint (pgbouncer), e.g.
#   postgresql://USER:PW@ep-xxxx-pooler.REGION.aws.neon.tech/db?sslmode=require&pgbouncer=true&connection_limit=1
# Local docker-compose default:
DATABASE_URL="postgresql://badminton:badminton@localhost:5432/badminton?schema=public"

# DIRECT (non-pooled) connection used ONLY for migrations/introspection — pgbouncer
# can't run those. In production use Neon's DIRECT endpoint (host WITHOUT `-pooler`).
# Locally, set it to the SAME value as DATABASE_URL above.
DIRECT_DATABASE_URL="postgresql://badminton:badminton@localhost:5432/badminton?schema=public"

# --- Auth / sessions -------------------------------------------------------
# 32+ char random secret used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# Session lifetime (seconds). Default 7 days.
SESSION_TTL_SECONDS=604800

# --- Email (password reset) -----------------------------------------------
# Provider: auto (Resend if a key is set, else console) | console | resend
EMAIL_PROVIDER=auto
# Get a free key at resend.com. Leave blank in dev to log reset links to console.
RESEND_API_KEY=
# Verified sender. Resend's shared onboarding sender works for testing:
EMAIL_FROM="Smash <onboarding@resend.dev>"
# How long a reset link stays valid (seconds).
PASSWORD_RESET_TTL_SECONDS=3600

# --- Misc ------------------------------------------------------------------
# Default region for parsing national phone numbers without a country code.
DEFAULT_PHONE_REGION=IN
