# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# Environment: development | test | production
NODE_ENV=development

# Public base URL of the app (used for CORS + absolute links)
APP_URL=http://localhost:3000

# PostgreSQL connection string (runtime queries).
# Local default:
DATABASE_URL="postgresql://badminton:badminton@localhost:5432/badminton?schema=public"
# Direct (non-pooled) connection used ONLY for `prisma migrate deploy`.
# - Local/CI: same as DATABASE_URL.
# - Neon prod: set DATABASE_URL to the POOLED host (…-pooler…&pgbouncer=true&connection_limit=1)
#   and DIRECT_DATABASE_URL to the DIRECT host (no "-pooler").
DIRECT_DATABASE_URL="postgresql://badminton:badminton@localhost:5432/badminton?schema=public"

# --- Auth / sessions -------------------------------------------------------
# 32+ char random secret used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# Session lifetime (seconds). Default 7 days.
SESSION_TTL_SECONDS=604800

# --- Email (password reset) -----------------------------------------------
# Provider: auto (Resend if a key is set, else console) | console | resend
EMAIL_PROVIDER=auto
# Get a free key at resend.com. Leave blank in dev to log reset links to console.
RESEND_API_KEY=
# Verified sender. Resend's shared onboarding sender works for testing:
EMAIL_FROM="Smash <onboarding@resend.dev>"
# How long a reset link stays valid (seconds).
PASSWORD_RESET_TTL_SECONDS=3600

# --- Phone OTP (sign-in by phone) ------------------------------------------
# Phone + OTP sign-in is HIDDEN by default (Indian OTP SMS needs a DLT-registered
# sender = a registered company, which we don't have yet). Flip this to `true` at
# build time to show the Phone tab and enable the OTP endpoints — no code changes.
NEXT_PUBLIC_PHONE_AUTH_ENABLED=false
# `auto` uses SMSLocal when SMSLOCAL_API_KEY is set, else `console` (logs the
# code to the server output — zero setup for dev / before DLT is approved).
OTP_PROVIDER=auto
OTP_TTL_SECONDS=300
# SMSLocal (India, DLT). Get these from the SMSLocal dashboard after DLT setup:
# a 6-char sender ID (header), an approved OTP template id, and the template's
# variable name for the code.
SMSLOCAL_API_KEY=
SMSLOCAL_SENDER_ID=
SMSLOCAL_TEMPLATE_ID=
SMSLOCAL_OTP_VAR=otp

# --- Misc ------------------------------------------------------------------
# Default region for parsing national phone numbers without a country code.
DEFAULT_PHONE_REGION=IN
