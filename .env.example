# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# Environment: development | test | production
NODE_ENV=development

# Public base URL of the app (used for CORS + absolute links)
APP_URL=http://localhost:3000

# PostgreSQL connection string
# Local docker-compose default:
DATABASE_URL="postgresql://badminton:badminton@localhost:5432/badminton?schema=public"

# --- Auth / sessions -------------------------------------------------------
# 32+ char random secret used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# Session lifetime (seconds). Default 7 days.
SESSION_TTL_SECONDS=604800

# --- Misc ------------------------------------------------------------------
# Default region for parsing national phone numbers without a country code.
DEFAULT_PHONE_REGION=IN
